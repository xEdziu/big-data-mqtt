          "title": "Pomiary / s (ostatnia minuta)",
          "description": "Velocity: liczba pomiarów zarejestrowanych w ostatniej minucie (czas zdarzenia).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb"
                      },
                      "spec": {
                        "query": "from(bucket: \"telemetry\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._field == \"delay_ms\")\n  |> group()\n  |> count()\n  |> map(fn: (r) => ({_value: float(v: r._value) / 60.0}))"
